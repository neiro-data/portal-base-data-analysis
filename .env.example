# Copy to .env and adjust as needed. .env is gitignored — never commit real secrets.

POSTGRES_USER=base_gov
POSTGRES_PASSWORD=base_gov
POSTGRES_DB=base_gov
POSTGRES_PORT=55433
POSTGRES_HOST=localhost
# DATABASE_URL=postgresql://base_gov:base_gov@localhost:55433/base_gov

# Version pins for docker/postgres/Dockerfile — keep in sync with docker-compose.yml.
PG_MAJOR=17
PG_PARQUET_VERSION=0.5.1
PGRX_VERSION=0.16.0

# NOTE: ./data is bind-mounted read-only at the fixed in-container path
# /parquet (docker-compose.yml), which sql/ingest/*.sql's COPY statements
# hardcode — there is no env var for this; it isn't meant to be relocatable.

# GRAFANA_DB_PASSWORD is read by the grafana service (docker-compose.yml) and
# passed through to the provisioned Postgres datasource. It must match
# grafana_reader's actual password, which is a literal 'changeme_grafana'
# baked into sql/004_grafana_role.sql — initdb .sql files can't read
# environment variables. Rotating the password means changing it in BOTH
# places: sql/004_grafana_role.sql (or `ALTER ROLE grafana_reader WITH
# PASSWORD '...'` after init) AND here, before any non-local deployment.
GRAFANA_DB_PASSWORD=changeme_grafana

# Grafana dashboards over the procurement schema (docker compose --profile
# dashboard up -d). Bound to 127.0.0.1 only — see README's Dashboards section.
GRAFANA_PORT=3001

# Shared secret between grafana and the image renderer (PDF reports). Replace the default.
GRAFANA_RENDERER_TOKEN=changeme_renderer
